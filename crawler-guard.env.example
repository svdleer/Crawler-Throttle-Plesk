# Safe default: reports only. Set MODE=apply only after reviewing dry-run reports.
MODE=dry-run

ACCESS_LOG=/home/httpd/vhosts/digisteden.nl/logs/access_ssl_log
LOG_READ_BYTES=4000000
LOG_WINDOW_SECONDS=60
DYNAMIC_PREFIXES=/nieuws,/agenda,/trefwoorden,/columns,/vacatures,/adressen,/rss,/ondernemend
EXCLUDED_PREFIXES=/adm,/__api__,/livewire,/storage/,/css/,/js/,/fonts/,/images/,/build/,/sitemaps/
TRUSTED_LISTS=/etc/nginx/office-exceptions.conf:/etc/nginx/google-special-crawlers.conf:/etc/nginx/facebook-crawlers.conf:/etc/nginx/known-good-bots.conf

# Phase 1: local behaviour needs enough rate and URL diversity to be suspicious.
IP_THRESHOLD=15
MIN_UNIQUE_URLS=5

# Report-only distributed-IP patterns; never automatically blocked.
CLUSTER_THRESHOLD=30
CLUSTER_MIN_IPS=8
SUBNET_THRESHOLD=40
SUBNET_MIN_IPS=4

# Phase 2: Cloudflare must have recorded this many rate-limit actions recently.
CF_EVENT_LOOKBACK_SECONDS=900
RECIDIVE_SOURCES=ratelimit
RECIDIVE_429_THRESHOLD=3

# Required only in MODE=apply. Keep the token in a root-owned 0600 file.
CF_API_TOKEN_FILE=/etc/digisteden-crawler-guard/cloudflare.token
CF_ZONE_ID=93a7798813c01f0aba4734fe3d3cc3a5
CF_RULESET_ID=96f13a70672245bf98e452f89eddcb26
# Use a dedicated IP-only Cloudflare custom block rule: ip.src in { ... }
CF_BLOCK_RULE_ID=REPLACE_WITH_DEDICATED_AUTOMATED_BLOCK_RULE_ID
MAX_BLOCKLIST_ENTRIES=100
